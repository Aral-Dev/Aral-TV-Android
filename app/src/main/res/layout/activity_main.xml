<?xml version="1.0" encoding="utf-8"?>
<!-- اپ اصلی — فقط یک قاب تمیز دور سایت:
     WebView تمام‌صفحه + نوار پیشرفت ۲dp + صفحهٔ خطا (فقط وقتی قطع باشد) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <WebView
        android:id="@+id/web"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ProgressBar
        android:id="@+id/progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_gravity="top"
        android:max="100"
        android:progressTint="@color/fire"
        android:progressBackgroundTint="@android:color/transparent"
        android:visibility="gone" />

    <!-- صفحهٔ خطا — همان برندینگ سایت، دکمه‌ها با استایل .btn سایت -->
    <FrameLayout
        android:id="@+id/errorOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingLeft="28dp"
            android:paddingRight="28dp">

            <ImageView
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:contentDescription="Aral TV"
                android:src="@drawable/logo" />

            <TextView
                android:id="@+id/errBrand"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Aral TV"
                android:textColor="@color/text_primary"
                android:textSize="26sp" />

            <TextView
                android:id="@+id/errTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/error_title"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/errSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/error_sub"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnRetry"
                android:layout_width="230dp"
                android:layout_height="50dp"
                android:layout_marginTop="26dp"
                android:text="@string/error_retry"
                android:textColor="@color/fire_ink"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnChangePanel"
                android:layout_width="230dp"
                android:layout_height="46dp"
                android:layout_marginTop="10dp"
                android:text="@string/error_change"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/errMono"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:letterSpacing="0.2"
                android:text="ARAL TV · ANDROID"
                android:textColor="@color/dim"
                android:textSize="10sp" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
